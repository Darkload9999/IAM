# ZEIT26 Identity Hub settings. Copy to .env (never commit .env).

# Where the Hub listens, and the address people open. The sign-in callback
# <HUB_PUBLIC_URL>/auth/callback must be registered in Asgardeo.
HUB_ADDR=:8090
HUB_PUBLIC_URL=http://localhost:8090

DATABASE_URL=postgres://user:password@127.0.0.1:5432/identity_hub?sslmode=disable

# The Asgardeo organization.
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<org>

# The Hub's own Asgardeo application (traditional web application, OIDC),
# with the email attribute shared.
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=

# The M2M application the Hub manages users with: SCIM2 Users API
# (internal_user_mgt_create, _list, _view, _update, _delete). Optionally the
# SCIM2 Groups API too, for per-application access groups.
ASGARDEO_M2M_CLIENT_ID=
ASGARDEO_M2M_CLIENT_SECRET=

# 32 random bytes, base64: openssl rand -base64 32. Encrypts the SCIM tokens
# the Hub keeps; losing it means issuing every application a new token.
HUB_ENCRYPTION_KEY=

# How often every Asgardeo user is read back into the Hub, and how long a
# dashboard session lasts.
HUB_SYNC_INTERVAL=10m
HUB_SESSION_TTL=8h
